          "raw": "{\n  \"title\": \"PM Kisan Samman Nidhi\",\n  \"description\": \"Financial benefit for farmers.\",\n  \"departmentId\": 1,\n  \"category\": \"Agriculture\",\n  \"eligibility\": \"All landholding farmers' families.\",\n  \"benefits\": \"Rs. 6000 per year.\",\n  \"requiredDocuments\": [\"Aadhaar Card\", \"Bank Passbook\"],\n  \"applicationProcess\": \"Apply online through the portal.\",\n  \"applicationUrl\": \"https://pmkisan.gov.in\",\n  \"officialWebsite\": \"https://pmkisan.gov.in\",\n  \"status\": \"ACTIVE\",\n  \"launchedYear\": 2019,\n  \"beneficiaryCount\": \"11 Crore+\",\n  \"tags\": [\"farmer\", \"agriculture\", \"subsidy\"],\n  \"featured\": true,\n  \"displayOrder\": 1\n}"
        },
